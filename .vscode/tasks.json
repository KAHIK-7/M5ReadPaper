{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PlatformIO: Build",
            "type": "shell",
            "command": "platformio",
            "args": [
                "run"
            ],
            "problemMatcher": [
                "$platformio"
            ],
            "group": "build"
        },
        {
            "label": "PlatformIO: Upload (COM4)",
            "type": "shell",
            "command": "platformio",
            "args": [
                "run",
                "--target",
                "upload",
                "--upload-port",
                "COM4"
            ],
            "problemMatcher": [
                "$platformio"
            ],
            "group": "build"
        },
        {
            "label": "PlatformIO: Upload SPIFFS (COM4)",
            "type": "shell",
            "command": "platformio",
            "args": [
                "run",
                "--target",
                "uploadfs",
                "--upload-port",
                "COM4"
            ],
            "problemMatcher": [
                "$platformio"
            ],
            "group": "build"
        },
        {
            "label": "PlatformIO: Clean",
            "type": "shell",
            "command": "platformio",
            "args": [
                "run",
                "--target",
                "clean"
            ],
            "problemMatcher": [
                "$platformio"
            ],
            "group": "build"
        },
        {
            "label": "PlatformIO: Monitor",
            "type": "shell",
            "command": "platformio",
            "args": [
                "device",
                "monitor",
                "--baud",
                "115200"
            ],
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}