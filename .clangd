# ============================================================================
# clangd 配置文件 - M5ReadPaper 项目
# 配置项说明: https://clangd.llvm.org/config
#
# 用法:
#   1. 确保 VSCode 已安装 clangd 扩展
#   2. 首次构建后运行: platformio run -t compiledb
#      这会生成 compile_commands.json, clangd 将自动读取精确的编译参数
#   3. 若无法构建, 本文件中的 CompileFlags 提供 fallback 配置
# ============================================================================

CompileFlags:
  # 添加 C++17 标准和 ESP32-S3 宏定义, 当 compile_commands.json 不可用时生效
  Add:
    - "-std=c++17"
    - "-target"
    - "xtensa-esp32s3-none-elf"
    - "-DESP32S3"
    - "-DBOARD_HAS_PSRAM"
    - "-DCONFIG_EPD_DISPLAY_TYPE_ED047TC1"
    - "-DCONFIG_EPD_BOARD_REVISION_V6"
    - "-DUSE_SD_MMC"
    - "-DARDUINO_M5STACK_PAPER_S3"
    - "-DARDUINO_USB_CDC_ON_BOOT=1"
    - "-DUSE_TINYUSB"

  # 移除 clangd 可能与 ESP-IDF 冲突的默认编译选项
  Remove:
    - "-m*"
    - "-f*"

# 索引配置
Index:
  Background: Build      # 后台构建索引 (不阻塞编辑)
  StandardLibrary: Yes   # 索引标准库符号

# 补全配置
Completion:
  AllScopes: Yes         # 跨作用域补全

# 诊断配置
Diagnostics:
  # 抑制 ESP32 平台中难以避免的特定警告
  Suppress:
    - "unused-parameter"
    - "unknown-pragmas"
    - "unused-but-set-variable"

  # clang-tidy 检查项: 仅启用不会引发大量噪音的规则
  ClangTidy:
    Add:
      - readability-identifier-naming     # 命名风格检查
      - modernize-use-nullptr             # 推荐 nullptr 替代 NULL
      - modernize-use-override            # 推荐 override 关键字
      - bugprone-*                        # 常见 bug 模式检测
    Remove:
      - bugprone-easily-swappable-parameters  # ESP32 API 参数多, 误报率高
    CheckOptions:
      # 命名风格规则:
      #   - 宏: UPPER_CASE
      #   - 函数: camelBack
      #   - 类型/类: CamelCase
      #   - 成员变量: 不强制检查 (项目风格不统一)
      readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
      readability-identifier-naming.FunctionCase: camelBack
      readability-identifier-naming.ClassCase: CamelCase
      readability-identifier-naming.StructCase: CamelCase
      readability-identifier-naming.EnumCase: CamelCase

# 悬停提示 (hover)
Hover:
  ShowAKA: Yes           # 显示类型别名